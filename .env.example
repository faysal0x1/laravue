APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=stocker
DB_PASSWORD=

# Database backups (storage/app/{DATABASE_BACKUP_DIRECTORY})
# DATABASE_BACKUP_DIRECTORY=database-backups
# DATABASE_BACKUP_RETENTION_DAYS=7
# DATABASE_BACKUP_SCHEDULE_AT=02:00
# DATABASE_BACKUP_PRUNE_SCHEDULE_AT=03:00
# DATABASE_BACKUP_MYSQLDUMP_PATH=mysqldump
# DATABASE_BACKUP_PG_DUMP_PATH=pg_dump

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Spatie Media Library: disk "media" → storage/app/media (see config/filesystems.php)
MEDIA_DISK=media
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Sidebar navigation (modules / sub_modules tables, cached)
# SIDEBAR_NAV_CACHE_KEY=sidebar.navigation
# SIDEBAR_NAV_CACHE_TTL=3600

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
